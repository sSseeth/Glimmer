#!/usr/bin/env bash
# commit-msg hook: enforces Conventional Commits and the AI trailer rules from
# AI_POLICY.md. Install with:  scripts/install-hooks.sh
#
# Also run by CI (pr-policy.yml) on every commit in a pull request.
set -euo pipefail

msg_file="$1"
# Ignore comment lines git adds to the editor buffer.
message="$(grep -v '^#' "$msg_file" || true)"
subject="$(printf '%s\n' "$message" | head -n1)"

fail() {
  echo "commit-msg: $1" >&2
  echo "  subject: $subject" >&2
  exit 1
}

# Merge/revert/fixup commits generated by git are allowed through.
if [[ "$subject" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
  exit 0
fi

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if ! [[ "$subject" =~ ^($types)(\([a-z0-9._/-]+\))?!?:\ .+ ]]; then
  fail "subject must look like 'type(scope): summary' where type is one of: ${types//|/, }"
fi
if (( ${#subject} > 72 )); then
  fail "subject is ${#subject} characters; keep it to 72 or fewer"
fi

# Assisted-by trailers must name a tool.
if printf '%s\n' "$message" | grep -Eiq '^Assisted-by:[[:space:]]*$'; then
  fail "'Assisted-by:' must name the tool, e.g. 'Assisted-by: Claude:claude-opus-5-5'"
fi

# AI tools are never authors or sign-offs (see AI_POLICY.md, "Attribution").
ai_names='claude|anthropic|copilot|chatgpt|openai|gpt|gemini|cursor|codex|devin|tabnine|codeium|windsurf|aider|grok|llama|mistral|deepseek'
if printf '%s\n' "$message" | grep -Ei '^(Co-authored-by|Signed-off-by):' | grep -Eiq "$ai_names"; then
  fail "credit AI tools with 'Assisted-by:', not 'Co-authored-by:' or 'Signed-off-by:'"
fi

exit 0
